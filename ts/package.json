{
  "name": "verbalis",
  "version": "0.1.0",
  "description": "Rewrites text the way it is read aloud: numbers, dates, symbols, abbreviations, and web addresses as words.",
  "license": "MIT",
  "author": "Software Mansion",
  "homepage": "https://github.com/software-mansion-labs/Verbalis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion-labs/Verbalis.git",
    "directory": "ts"
  },
  "bugs": "https://github.com/software-mansion-labs/Verbalis/issues",
  "keywords": [
    "tts",
    "text-normalization",
    "verbalization",
    "speech"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./de": {
      "types": "./dist/de.d.ts",
      "default": "./dist/de.js"
    },
    "./en": {
      "types": "./dist/en.d.ts",
      "default": "./dist/en.js"
    },
    "./es": {
      "types": "./dist/es.d.ts",
      "default": "./dist/es.js"
    },
    "./fr": {
      "types": "./dist/fr.d.ts",
      "default": "./dist/fr.js"
    },
    "./hi": {
      "types": "./dist/hi.d.ts",
      "default": "./dist/hi.js"
    },
    "./it": {
      "types": "./dist/it.d.ts",
      "default": "./dist/it.js"
    },
    "./pl": {
      "types": "./dist/pl.d.ts",
      "default": "./dist/pl.js"
    },
    "./pt": {
      "types": "./dist/pt.d.ts",
      "default": "./dist/pt.js"
    },
    "./zh": {
      "types": "./dist/zh.d.ts",
      "default": "./dist/zh.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test *.config.ts",
    "lint": "prettier --check src test *.config.ts && tsc --noEmit",
    "prepack": "tsdown && node -e \"const fs = require('fs'); for (const f of JSON.parse(/^license-files = (.*)$/m.exec(fs.readFileSync('../pyproject.toml', 'utf8'))[1])) fs.cpSync('../' + f, f)\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
